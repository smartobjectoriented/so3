+/*
+ * Boot ROM emulation.
+ *
+ * A real SoC starts by running a mask ROM that reads the first stage from
+ * whatever medium the board boots from — a raw offset of the eMMC or SD card,
+ * before any partition — and jumps into it. "virt" has no such ROM: QEMU
+ * either maps firmware into flash at address 0 or -kernel-loads an image into
+ * RAM, and in both cases the first stage comes from a host file rather than
+ * from the storage the guest can see.
+ *
+ * This reproduces the ROM's effect rather than the ROM itself, which is what
+ * QEMU already does for the Allwinner SoCs whose ROM boots from SD — see
+ * allwinner_h3_bootrom_setup() in hw/arm/allwinner-h3.c, which this follows.
+ * The bytes come off the drive, so a card carrying its own first stage boots
+ * here exactly as it does on hardware.
+ *
+ * Returns true when a first stage was loaded, in which case the caller starts
+ * the CPU at bootrom_load.
+ */
+static bool virt_bootrom_setup(VirtMachineState *vms)
+{
+    g_autofree uint8_t *buffer = NULL;
+    BlockBackend *blk;
+    int64_t len;
+
+    if (!vms->bootrom_drive) {
+        return false;
+    }
+
+    if (!vms->bootrom_load) {
+        error_report("bootrom-drive needs bootrom-load: the ROM has to be "
+                     "told where to put the first stage");
+        exit(1);
+    }
+
+    blk = blk_by_name(vms->bootrom_drive);
+    if (!blk) {
+        error_report("bootrom-drive=%s: no such drive", vms->bootrom_drive);
+        exit(1);
+    }
+
+    len = blk_getlength(blk);
+    if (len < 0 || (uint64_t)len < vms->bootrom_offset + vms->bootrom_size) {
+        error_report("bootrom-drive=%s: too small to hold %" PRIu64
+                     " bytes at offset %" PRIu64,
+                     vms->bootrom_drive, vms->bootrom_size,
+                     vms->bootrom_offset);
+        exit(1);
+    }
+
+    /*
+     * The drive is declared with if=none and claimed by a -device created
+     * after machine init, so nothing holds permissions on it yet. Take a
+     * read for the length of this function and give it straight back, so
+     * that device can still claim the drive as it expects to.
+     */
+    if (blk_set_perm(blk, BLK_PERM_CONSISTENT_READ, BLK_PERM_ALL, NULL) < 0) {
+        error_report("bootrom-drive=%s: cannot be read", vms->bootrom_drive);
+        exit(1);
+    }
+
+    buffer = g_malloc0(vms->bootrom_size);
+    if (blk_pread(blk, vms->bootrom_offset, vms->bootrom_size, buffer, 0) < 0) {
+        error_report("bootrom-drive=%s: read failed", vms->bootrom_drive);
+        exit(1);
+    }
+
+    blk_set_perm(blk, 0, BLK_PERM_ALL, NULL);
+
+    rom_add_blob("virt.bootrom", buffer, vms->bootrom_size, vms->bootrom_size,
+                 vms->bootrom_load, NULL, NULL, NULL, NULL, false);
+    return true;
+}
