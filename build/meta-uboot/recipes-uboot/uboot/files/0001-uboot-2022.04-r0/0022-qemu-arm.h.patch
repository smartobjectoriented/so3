+/*
+ * uEnv.txt is only on p1 once an OS has been deployed; with U-Boot alone
+ * there is nothing to import or run, so stay at the prompt instead of
+ * importing whatever lies at the load address and failing on "run start".
+ * The import takes an explicit format and length, as on rpi (see rpi.h).
+ */
+#define CONFIG_BOOTCOMMAND \
+        "if load virtio 0 0x40000000 uEnv.txt; then " \
+                "env import -t 0x40000000 ${filesize}; run start; " \
+        "else echo No uEnv.txt on the boot partition, no OS to boot; fi\0"
 
