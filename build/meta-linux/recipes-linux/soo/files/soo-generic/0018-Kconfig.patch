--- /dev/null
+++ ./soo/drivers/Kconfig
@@ -0,0 +1,51 @@
+#
+# SOO device configuration
+#
+
+
+menu "Smart Object Oriented subsystem" 
+
+config VDUMMY_BACKEND
+        bool "SOO vDummy support for debugging and testing"
+
+config VUART_BACKEND
+	bool "vuart UART Backend support for SO3 capsule consoles"
+	select SERIAL_CORE_CONSOLE
+	
+config VLEDS_BACKEND
+        bool "vleds LEDS backend driver"
+        default N
+        
+config VSENSELED_BACKEND
+	depends on FB_RPISENSE || ARCH_VEXPRESS
+	bool "vsenseled Sense-HAT led backend driver"
+	default n
+	help
+	  The vsenseled driver enables 5 logical LEDs that may be used to represent the joystick movement
+	  for example.
+
+config VSENSEJ_BACKEND
+	depends on FB_RPISENSE || ARCH_VEXPRESS
+	bool "vsensej Sense-HAT joystick backend driver"
+	default n
+	help
+	  The vsensej driver captures joystick movements.
+
+config VLOGS_BACKEND
+	bool "vlogs LOGS Backend support for SOO Capsules"
+	help
+	  The vlogs driver is used to logs Capsules logs - logs are store in
+	  `/var/log/soo/capsule_N.log` (N corresponds to the SlotID of the capsule).
+
+config VNET_BACKEND
+	bool "vnet backend for the capsule which carries a network"
+	help
+	  The packets of the capsule which carries the swarm's network
+	  (soonet): soonet0 for the agency's applications, and the
+	  capsule's frames on the radio.
+
+endmenu
+	
+
+
+
