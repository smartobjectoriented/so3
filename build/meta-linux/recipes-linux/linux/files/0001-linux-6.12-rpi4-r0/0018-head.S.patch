--- ./arch/arm64/kernel/head.S
+++ ./arch/arm64/kernel/head.S
@@ -82,6 +82,12 @@
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
 SYM_CODE_START(primary_entry)
+	/* TEMP rpi4 bring-up: MMU-off boot marker 'K' on the mini-UART */
+	mov	x16, #0x5040
+	movk	x16, #0xfe21, lsl #16
+	mov	w17, #0x4b			// 'K'
+	str	w17, [x16]
+
 	bl	record_mmu_state
 	bl	preserve_boot_args
 
@@ -119,6 +125,12 @@
 	bl	init_kernel_el			// w0=cpu_boot_mode
 	mov	x20, x0
 
+	/* TEMP rpi4 bring-up: marker 'E' after init_kernel_el */
+	mov	x16, #0x5040
+	movk	x16, #0xfe21, lsl #16
+	mov	w17, #0x45			// 'E'
+	str	w17, [x16]
+
 	/*
 	 * The following calls CPU setup code, see arch/arm64/mm/proc.S for
 	 * details.
@@ -519,6 +531,13 @@
 SYM_FUNC_END(__no_granule_support)
 
 SYM_FUNC_START_LOCAL(__primary_switch)
+	/* TEMP rpi4 bring-up: marker 'V' just before enabling the MMU
+	 * (last MMU-off point: the mini-UART is not in the idmap). */
+	mov	x16, #0x5040
+	movk	x16, #0xfe21, lsl #16
+	mov	w17, #0x56			// 'V'
+	str	w17, [x16]
+
 	adrp	x1, reserved_pg_dir
 	adrp	x2, init_idmap_pg_dir
 	bl	__enable_mmu
