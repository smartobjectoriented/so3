1"><mxGeometry x="0" y="10" width="1080" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Guests (EL1) — isolated by per-domain stage-2 tables (VTTBR)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="980" height="230" as="geometry"/></mxCell><mxCell id="c4" value="Agency  (DOMID_AGENCY)&#10;owns the devices&#10;vbstore server&#10;runs on CPU 0" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="120" width="200" height="150" as="geometry"/></mxCell><mxCell id="c5" value="Capsule (S3C)  slot 2&#10;SO3 guest&#10;stage-2 isolated" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="180" height="150" as="geometry"/></mxCell><mxCell id="c6" value="Capsule (S3C)  slot 3&#10;SO3 guest" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="180" height="150" as="geometry"/></mxCell><mxCell id="c7" value="… up to MAX_S3C_DOMAINS&#10;(2 agency + 5 capsules)&#10;run on the capsule CPU" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="120" width="260" height="150" as="geometry"/></mxCell><mxCell id="c8" value="AVZ hypervisor  (EL2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="980" height="170" as="geometry"/></mxCell><mxCell id="c9" value="Domain scheduler&#10;sched_agency&#10;sched_flip (capsules)&#10;per-CPU current_domain" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="370" width="200" height="100" as="geometry"/></mxCell><mxCell id="c10" value="Hypercalls (hvc #0)&#10;console · event channels&#10;domain control · grant tables" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="370" width="200" height="100" as="geometry"/></mxCell><mxCell id="c11" value="vGIC&#10;phys IRQ → EL2 (HCR.IMO)&#10;inject via list registers (HW=1)&#10;maintenance IRQ" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="370" width="220" height="100" as="geometry"/></mxCell><mxCell id="c12" value="Grant tables &amp;&#10;event channels&#10;inter-domain memory&#10;+ signalling" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="810" y="370" width="200" height="100" as="geometry"/></mxCell><mxCell id="c13" value="Physical GIC · generic timer · UART · RAM" style="fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="980" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="capsule" id="capsule"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SO3 capsules: split drivers (vbus / vbstore)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1080" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Split-driver model (per device)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="470" height="330" as="geometry"/></mxCell><mxCell id="c4" value="Capsule — frontend&#10;(S3C, EL1)&#10;vfbdev / vinput /&#10;vuart / vuihandler" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="95" y="120" width="180" height="90" as="geometry"/></mxCell><mxCell id="c5" value="Agency — backend&#10;(Linux, EL1)&#10;real device" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="335" y="120" width="160" height="90" as="geometry"/></mxCell><mxCell id="c6" value="shared ring + event channel&#10;(pages shared via grant tables)" style="fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="160" y="250" width="250" height="60" as="geometry"/></mxCell><mxCell id="c7" value="vbstore handshake" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;dashed=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="Each virtual device is split: the frontend in the&#10;capsule talks to a backend in the Linux agency." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="95" y="330" width="400" height="50" as="geometry"/></mxCell><mxCell id="c11" value="vbstore  (Xenstore-like config tree)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="470" height="330" as="geometry"/></mxCell><mxCell id="c12" value="device/&lt;domID&gt;/&lt;dev&gt;/state  →  Connected" style="fillColor=#ffffff;strokeColor=#666666;fontSize=9;" vertex="1" parent="1"><mxGeometry x="605" y="120" width="400" height="40" as="geometry"/></mxCell><mxCell id="c13" value="ring-ref · event-channel · protocol params" style="fillColor=#ffffff;strokeColor=#666666;fontSize=9;" vertex="1" parent="1"><mxGeometry x="605" y="175" width="400" height="40" as="geometry"/></mxCell><mxCell id="c14" value="Frontend and backend rendez-vous through the&#10;vbstore tree; the state machine drives probe(),&#10;connect, suspend and resume of each device." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="605" y="230" width="400" height="90" as="geometry"/></mxCell><mxCell id="c15" value="snapshot: AVZ_S3C_READ/WRITE_SNAPSHOT&#10;save &amp; restore a capsule&#x27;s state" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1"><mxGeometry x="605" y="330" width="400" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="device-model" id="device-model"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Device &amp; driver model (FDT-driven)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1080" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Device Tree blob&#10;(dts/*.dtb)&#10;loaded by U-Boot" style="fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="200" height="80" as="geometry"/></mxCell><mxCell id="c4" value="parse_dtb()&#10;walk FDT nodes&#10;match “compatible”" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="200" height="80" as="geometry"/></mxCell><mxCell id="c5" value="initcall sections&#10;(.initcall_driver_*&#10;core / postcore)&#10;via ll_entry" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="90" width="220" height="80" as="geometry"/></mxCell><mxCell id="c6" value="driver .init(dev,&#10;fdt_offset)&#10;probe hardware" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="200" height="80" as="geometry"/></mxCell><mxCell id="c7" value="devclass_register()&#10;class + fops + id&#10;(fb, input, serial,&#10;nic, char, …)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="220" height="80" as="geometry"/></mxCell><mxCell id="c8" value="devfs&#10;exposes /dev/&lt;name&gt;" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="200" height="80" as="geometry"/></mxCell><mxCell id="c9" value="User space&#10;open(&quot;/dev/...&quot;)&#10;read/write/ioctl" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="200" height="80" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="Drivers register with REGISTER_DRIVER_CORE / _POSTCORE, which place an initcall entry in a dedicated linker section. At boot parse_dtb() matches each FDT node&#x27;s “compatible” string to a driver and calls its init() callback; the driver then publishes a devclass that VFS/devfs makes reachable as a /dev entry." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1000" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="build" id="build"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Infrabase build &amp; deploy flow" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1080" height="30" as="geometry"/></mxCell><mxCell id="c3" value="build/conf/local.conf&#10;&#10;IB_PLATFORM · IB_CONFIG:so3&#10;IB_TARGET_ITS:so3 · IB_BOOT_CHAIN" style="fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="110" as="geometry"/></mxCell><mxCell id="c4" value="scripts/build.sh&#10;-a bsp-so3  (-k / -x / -c)" style="fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="78" width="230" height="74" as="geometry"/></mxCell><mxCell id="c5" value="bitbake&#10;meta-* layers + 