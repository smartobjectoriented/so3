# General SO3 build/run environment (Infrabase).
#
# Copyright (c) 2025-2026 REDS Institute, HEIG-VD
#
# A thin layer over the toolchains base: it carries every host prerequisite to
# build SO3 with Infrabase (bitbake) and to build/run the patched QEMU. The
# repository is mounted at run time (see .github/workflows/build.yml), e.g.:
#
#   docker run --rm -v "$PWD:/so3" ghcr.io/smartobjectoriented/so3-env:latest \
#       bash -c 'cd /so3 && . ./env.sh && build.sh -x so3'
#
# QEMU is built by the meta-qemu recipe inside the working tree
# (`build.sh -x qemu`), so it is no longer baked here.

FROM ghcr.io/smartobjectoriented/so3-toolchains:latest

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

WORKDIR /so3
