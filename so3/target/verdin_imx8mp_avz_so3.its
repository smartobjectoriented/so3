/dts-v1/;

/ {
	description = "AVZ hypervisor + SO3 guest for the Toradex Verdin iMX8MP";

	images {
		avz {
			description = "AVZ Hypervisor (64-bit) Polymorphic SO3";
			data = /incbin/("../../avz/so3.bin");
			type = "kernel";
			os = "linux";
			arch = "arm64";
			compression = "none";
			load = <0x40080000>;
			entry = <0x40080000>;
		};

		avz_dt {
			description = "AVZ flattened device tree blob";
			data = /incbin/("../../avz/dts/verdin-imx8mp_avz.dtb");
			type = "avz_dt";
			arch = "arm64";
			compression = "none";
			load = <0x46000000>;
		};

		so3 {
			description = "SO3 OS kernel (guest)";
			data = /incbin/("../so3/so3.bin");
			type = "guest";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x48000000>;
			entry = <0x48000000>;
		};

		fdt {
			description = "SO3 guest flattened device tree blob";
			data = /incbin/("../so3/dts/verdin-imx8mp.dtb");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			load = <0x50200000>;
		};

		ramfs {
			description = "SO3 environment minimal rootfs";
			data = /incbin/("../rootfs/rootfs.fat");
			type = "ramdisk";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x50c00000>;
		};
	};

	configurations {
		default = "so3_guest";

		so3_guest {
			description = "SO3 kernel image including device tree";
			kernel = "avz";
			loadables = "avz_dt", "so3";
			fdt = "fdt";
			ramdisk = "ramfs";
		};
	};
};
