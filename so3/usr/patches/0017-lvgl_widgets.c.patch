+/*
+ * Standalone LVGL widgets demo (lvgl/demos/widgets/lv_demo_widgets.c).
+ * slv_init() brings up the LCD (PL111 framebuffer), the keyboard and mouse
+ * (PL050) and the LVGL tick thread; then we build the widgets UI and run
+ * the LVGL event loop until the app is killed (Ctrl-C).
+ */
+
+#include <demos/lv_demos.h>
+#include <widgets/lv_demo_widgets.h>
+
+#include <slv.h>
+
+#include <stdlib.h>
+#include <stdio.h>
+
+int main(int argc, char **argv)
+{
+	printf("Starting LVGL widgets demo\n");
+
+	/* Initialise the display (LCD), keyboard and mouse + tick thread. */
+	slv_t slv;
+	int err = slv_init(&slv);
+	if (err < 0) {
+		printf("Failed to init SLV\n");
+		return EXIT_FAILURE;
+	}
+
+	/* Build the widgets demo UI. */
+	lv_demo_widgets();
+
+	/* Run the LVGL loop (renders + dispatches keyboard/mouse input). */
+	slv_loop(&slv);
+
+	slv_terminate(&slv);
+
+	return EXIT_SUCCESS;
+}
